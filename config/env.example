# PequiFlux Yard Copilot environment sample.
# Do not put secrets here. Copy values into your shell or Docker Compose environment.

PEQUIFLUX_GEMMA_RUNTIME=text
GEMMA_BASE_URL=http://gemma:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_TIMEOUT_SECONDS=45
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=24h
PEQUIFLUX_SQLITE_PATH=var/db/pequiflux.db

# Optional SonarQube gate. Keep token outside the repository.
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_TOKEN=
