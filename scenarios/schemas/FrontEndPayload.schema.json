{
  "$defs": {
    "AuditRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "fifo_break": {
          "default": false,
          "title": "Fifo Break",
          "type": "boolean"
        },
        "fired_rules": {
          "items": {
            "type": "string"
          },
          "title": "Fired Rules",
          "type": "array"
        },
        "hard_constraints_checked": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Hard Constraints Checked",
          "type": "array"
        },
        "latencies_ms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Latencies Ms",
          "type": "object"
        },
        "operator_action": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Action"
        },
        "provenance": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Provenance",
          "type": "array"
        },
        "recommended_pair": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Pair"
        },
        "rejected_candidates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Rejected Candidates",
          "type": "array"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCallRecord"
          },
          "title": "Tool Calls",
          "type": "array"
        },
        "truth_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/TruthResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "enum": [
            "fifo",
            "heuristic",
            "full"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "request_id",
        "scenario_id",
        "variant"
      ],
      "title": "AuditRecord",
      "type": "object"
    },
    "ConstraintFailure": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "severity",
        "source",
        "detail"
      ],
      "title": "ConstraintFailure",
      "type": "object"
    },
    "DecisionStatus": {
      "enum": [
        "PREVIEW_READY",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "APPROVED",
        "OVERRIDDEN"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "DriverMessage": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "message",
        "template_id"
      ],
      "title": "DriverMessage",
      "type": "object"
    },
    "GemmaVisibleSummary": {
      "additionalProperties": false,
      "properties": {
        "exception_label": {
          "title": "Exception Label",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "parsed_fields": {
          "items": {
            "type": "string"
          },
          "title": "Parsed Fields",
          "type": "array"
        }
      },
      "required": [
        "exception_label"
      ],
      "title": "GemmaVisibleSummary",
      "type": "object"
    },
    "OperatorAction": {
      "enum": [
        "approve",
        "block",
        "override"
      ],
      "title": "OperatorAction",
      "type": "string"
    },
    "QueueDiffEntry": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "position_after": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position After"
        },
        "position_before": {
          "title": "Position Before",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "truck_id": {
          "title": "Truck Id",
          "type": "string"
        }
      },
      "required": [
        "truck_id",
        "position_before",
        "position_after",
        "decision",
        "reason"
      ],
      "title": "QueueDiffEntry",
      "type": "object"
    },
    "RecommendedDestination": {
      "additionalProperties": false,
      "properties": {
        "destination_id": {
          "title": "Destination Id",
          "type": "string"
        },
        "destination_type": {
          "title": "Destination Type",
          "type": "string"
        }
      },
      "required": [
        "destination_id",
        "destination_type"
      ],
      "title": "RecommendedDestination",
      "type": "object"
    },
    "RecommendedTruck": {
      "additionalProperties": false,
      "properties": {
        "queue_position_after": {
          "title": "Queue Position After",
          "type": "integer"
        },
        "queue_position_before": {
          "title": "Queue Position Before",
          "type": "integer"
        },
        "truck_id": {
          "title": "Truck Id",
          "type": "string"
        }
      },
      "required": [
        "truck_id",
        "queue_position_before",
        "queue_position_after"
      ],
      "title": "RecommendedTruck",
      "type": "object"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "purpose": {
          "default": "",
          "maxLength": 240,
          "title": "Purpose",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "status": {
          "enum": [
            "requested",
            "executed",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_name": {
          "enum": [
            "validate_hard_constraints",
            "rank_candidates",
            "generate_audit_payload"
          ],
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "request_id",
        "state",
        "status"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    },
    "TruthResolution": {
      "additionalProperties": false,
      "properties": {
        "authoritative_sources": {
          "items": {
            "type": "string"
          },
          "title": "Authoritative Sources",
          "type": "array"
        },
        "material_conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Material Conflicts",
          "type": "array"
        }
      },
      "required": [
        "authoritative_sources"
      ],
      "title": "TruthResolution",
      "type": "object"
    }
  },
  "$id": "schemas/FrontEndPayload.schema.json",
  "additionalProperties": false,
  "properties": {
    "audit_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "benchmark_observed": {
      "additionalProperties": true,
      "title": "Benchmark Observed",
      "type": "object"
    },
    "benchmark_tags": {
      "items": {
        "type": "string"
      },
      "title": "Benchmark Tags",
      "type": "array"
    },
    "confidence_notes": {
      "items": {
        "type": "string"
      },
      "title": "Confidence Notes",
      "type": "array"
    },
    "considered_constraints": {
      "items": {
        "$ref": "#/$defs/ConstraintFailure"
      },
      "title": "Considered Constraints",
      "type": "array"
    },
    "decision_status": {
      "$ref": "#/$defs/DecisionStatus"
    },
    "driver_message": {
      "$ref": "#/$defs/DriverMessage"
    },
    "gemma_visible_summary": {
      "$ref": "#/$defs/GemmaVisibleSummary"
    },
    "latency_ms": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Latency Ms",
      "type": "object"
    },
    "operator_actions": {
      "items": {
        "$ref": "#/$defs/OperatorAction"
      },
      "title": "Operator Actions",
      "type": "array"
    },
    "queue_diff": {
      "items": {
        "$ref": "#/$defs/QueueDiffEntry"
      },
      "title": "Queue Diff",
      "type": "array"
    },
    "reason_details": {
      "items": {
        "type": "string"
      },
      "title": "Reason Details",
      "type": "array"
    },
    "reason_summary": {
      "title": "Reason Summary",
      "type": "string"
    },
    "recommended_destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecommendedDestination"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommended_truck": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecommendedTruck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "variant": {
      "enum": [
        "fifo",
        "heuristic",
        "full"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "scenario_id",
    "variant",
    "decision_status",
    "reason_summary",
    "driver_message",
    "gemma_visible_summary"
  ],
  "title": "FrontEndPayload",
  "type": "object"
}
